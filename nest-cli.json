{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "app/v1/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": false,
    "assets": [
      { "include": "i18n/**/*", "watchAssets": true }
    ],
    "plugins": ["@nestjs/swagger"]

  }
}
