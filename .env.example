POSTGRES_PASSWORD=pass123
POSTGRES_DB=softy_rh_db
POSTGRES_PORT=5432
POSTGRES_HOST=db  # Should match the 'db' service from Docker Compose
 
# Keycloak Environment Variables
KEYCLOAK_URL=http://host.docker.internal:8081
KEYCLOAK_ADMIN_USER=owner
KEYCLOAK_ADMIN_PASSWORD=owner
KEYCLOAK_REALM=softy
KEYCLOAK_CLIENT_ID=rh-service-client
