# Keycloak PostgreSQL Database Configuration
KEYCLOAK_DB_VENDOR=postgres                # Specify the database vendor
KEYCLOAK_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/keycloak  # Keycloak database URL
KEYCLOAK_DB_DATABASE=keycloak              # Name of the Keycloak database
KEYCLOAK_DB_USERNAME=admin                  # Database user for Keycloak
KEYCLOAK_DB_PASSWORD=pass123      
         # Database password for Keycloak
 
