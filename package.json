  "scripts": {
    "build": "npx @nestjs/cli build -p tsconfig.build.json",
    "format": "prettier --write \"app/v1/src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/app/v1/src/main",
    "start:dev": "ts-node-dev --respawn --transpile-only app/v1/src/main.ts",
    "start:debug": "nest start --debug --watch",
    "start:prod": "nde dist/main",
    "lint": "eslint \"app/v1/src/**/*.ts\" \"test/**/*.ts\" --fix",
    "test": "jest --config ./test/jest.config.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "migration:run": "pnpm exec ts-node app/v1/src/database/migrationScripts/run.migration.ts",
    "migration:create": "pnpm exec ts-node app/v1/src/database/migrationScripts/create.migration.ts",
    "migration:list": "ts-node -r tsconfig-paths/register app/v1/src/database/migrationScripts/list.applied.migration.ts",
    "tenant:migration:create": "pnpm exec ts-node app/v1/src/tenants/database/migrationScripts/create.migration.ts",
    "apply-migrations": "ts-node app/v1/src/tenants/database/migrationScripts/applyForAllTenants.migration.ts",
    "migration:test": "pnpm exec ts-node app/v1/src/tenants/database/migrationScripts/test.migration.ts",
    "prepare": "husky",
    "connection-monitor": "ts-node app/v1/src/tenants/database/connectionMonitor/connectionMonitor.ts",
    "tenant:seed": "ts-node app/v1/src/tenants/database/seeders/seedAllTenants.seeder.ts"
  },
  "dependencies": {
    "@jest/types": "^29.6.3",
    "@nestjs/common": "^10.4.5",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.5",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/platform-express": "^10.4.5",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/throttler": "^6.2.1",
    "axios": "^1.7.7",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dockerode": "^4.0.2",
    "dotenv": "^16.4.5",
    "dropbox": "^10.34.0",
    "express": "^4.21.2",
    "form-data": "^4.0.1",
    "fs": "0.0.1-security",
    "generate-password": "^1.7.1",
    "glob": "^11.0.0",
    "i18next": "^23.16.0",
    "i18next-fs-backend": "^2.3.2",
    "jsonwebtoken": "^9.0.2",
    "keycloak-connect": "^26.0.5",
    "kysely": "^0.27.4",
    "kysely-migration-cli": "^0.4.2",
    "nest-keycloak-connect": "^1.10.1",
    "nestjs-i18n": "^10.4.9",
    "pg": "^8.13.0",
    "qs": "^6.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "umzug": "^3.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.2",
    "@nestjs/testing": "^10.4.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.13",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.16.12",
    "@types/qs": "^6.9.16",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.10.0",
    "@typescript-eslint/parser": "^8.10.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "install": "^0.13.0",
    "jest": "^29.7.0",
    "npm": "^11.0.0",
    "prettier": "^3.3.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "packageManager": "pnpm@9.12.1+sha512.e5a7e52a4183a02d5931057f7a0dbff9d5e9ce3161e33fa68ae392125b79282a8a8a470a51dfc8a0ed86221442eb2fb57019b0990ed24fab519bf0e1bc5ccfc4"
}
